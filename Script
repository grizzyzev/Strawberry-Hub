local Pages = {}
for i, name in ipairs(TAB_NAMES) do
    Pages[name] = createPage(name)
    createTab(name, i, #TAB_NAMES)
end


local function pageOf(inst)
    local cur = inst
    while cur do
        if cur:IsA("ScrollingFrame") and pages[cur.Name] then return cur.Name end
        cur = cur.Parent
    end
    return nil
end


