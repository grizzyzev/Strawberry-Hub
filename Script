local function createTab(name, index, _total)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.LayoutOrder = index
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = tabList
    roundify(btn, 7)

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.fromOffset(16, 16)
    icon.AnchorPoint = Vector2.new(0, 0.5)
    icon.Position = UDim2.new(0, 10, 0.5, 0)
    icon.BackgroundTransparency = 1
    icon.Image = H.TAB_ICONS[name] or ""
    icon.Parent = btn

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -40, 1, 0)
    lbl.Position = UDim2.fromOffset(36, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = TAB_LABELS[name] or name
    lbl.TextSize = 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Parent = btn

    local hovered = false
    local function refresh()
        local a = currentPage == name
        btn.BackgroundColor3 = a and Theme.Control or Theme.Hover
        tween(btn, 0.12, {BackgroundTransparency = a and 0 or (hovered and 0.6 or 1)})
        local col = (a or hovered) and Theme.Text or Theme.Dim
        lbl.TextColor3 = col
        lbl.Font = a and Enum.Font.GothamMedium or Enum.Font.Gotham
        icon.ImageColor3 = col
    end
    tabRefresh[name] = refresh
    bind(refresh)

    btn.MouseEnter:Connect(function() hovered = true; refresh() end)
    btn.MouseLeave:Connect(function() hovered = false; refresh() end)
    btn.Activated:Connect(function()
        if currentPage ~= name then switchPage(name) end
    end)
end

