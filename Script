if not game:IsLoaded() then
    game.Loaded:Wait()
end

local SCRIPTS = {
    primeval = "https://api.luarmor.net/files/v4/loaders/b8c171b96c2ad3b3c869ae572cb2ca22.lua",
    sniper = "https://api.luarmor.net/files/v4/loaders/98096e4869522b965b4e94bde2cf4f42.lua",
    bugevolution = "https://api.luarmor.net/files/v4/loaders/386d315125cf7415d381cf735ec39ecc.lua",
    homedefense = "https://api.luarmor.net/files/v4/loaders/f15f02bdaac4ad8e23487f8e3fbae549.lua",
    jurassic = "https://api.luarmor.net/files/v4/loaders/fbfae5030b450af43a6d5a83ae53aff8.lua",
}

local NAMES = {
    primeval = "Primeval Earth",
    sniper = "Sniper Arena",
    bugevolution = "Bug Evolution",
    homedefense = "Home Defense",
    jurassic = "Jurassic Blocky",
}

local PLACES = {
    [10696301650] = "primeval",
    [122446657157717] = "sniper",
    [90165746516953] = "sniper",
    [70650894743738] = "bugevolution",
    [105527962898452] = "homedefense",
    [11653088948] = "jurassic",
}

local GAMES = {
    [9534705677] = "sniper",
    [10769957062] = "bugevolution",
    [10769857262] = "homedefense",
    [4130569984] = "jurassic",
}

-- fallback when a place isn't listed (sub-places, new servers): match the game's name
local KEYWORDS = {
    {"primeval", "primeval"},
    {"sniper arena", "sniper"},
    {"bug evolution", "bugevolution"},
    {"home defense", "homedefense"},
    {"jurassic", "jurassic"},
}

-- games with several places (lobby, matches, event servers): recognise them by what's in the game
local SIGNATURES = {
    jurassic = function()
        local rs = game:GetService("ReplicatedStorage")
        local ts = rs:FindFirstChild("TS")
        local config = ts and ts:FindFirstChild("config")
        return config ~= nil and config:FindFirstChild("dinosaur-stats") ~= nil
    end,
}

-- universe ids remembered by the hubs themselves (Jurassic Blocky writes its own on first run)
local SAVED_GAME_IDS = {
    jurassic = "StrawberryHub/jurassic_gameid.txt",
}

local DISCORD = "discord.gg/AH8SRWBxQy"

local function notify(text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Strawberry Hub",
            Text = text,
            Duration = duration or 10,
        })
    end)
end

local function detect()
    local which = PLACES[game.PlaceId] or GAMES[game.GameId]
    if which then return which end
    for key, path in pairs(SAVED_GAME_IDS) do
        local ok, saved = pcall(function() return isfile(path) and readfile(path) end)
        if ok and saved and tonumber(saved) == game.GameId then return key end
    end
    for key, check in pairs(SIGNATURES) do
        local ok, match = pcall(check)
        if ok and match then return key end
    end
    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    local name = ok and info and string.lower(tostring(info.Name)) or ""
    for _, k in ipairs(KEYWORDS) do
        if string.find(name, k[1], 1, true) then return k[2] end
    end
    return nil
end

-- game:HttpGet first, then the executor's request function if that fails
local function fetch(url)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then return body end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok2, res = pcall(req, {Url = url, Method = "GET"})
        if ok2 and res and type(res.Body) == "string" and #res.Body > 0 then return res.Body end
    end
    return nil, tostring(body)
end

-- the game can still be loading its folders (e.g. "Spawning..."): retry for a few seconds
local which = detect()
local tries = 0
while not which and tries < 10 do
    task.wait(1)
    tries = tries + 1
    which = detect()
end
local url = which and SCRIPTS[which]
if not url then
    -- show + copy the ids so a missing place can be added right away
    local gameName = "?"
    pcall(function() gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
    local info = string.format("PlaceId %d | GameId %d | %s", game.PlaceId, game.GameId, gameName)
    pcall(setclipboard, info)
    warn("[Strawberry Hub] unsupported: " .. info)
    notify("This game isn't supported yet (" .. info .. "). Info copied. Discord: " .. DISCORD, 15)
    return
end

notify("Loading " .. NAMES[which] .. "...", 4)

local src, httpErr = fetch(url)
if not src then
    notify("Couldn't download the script. Check your internet / executor and try again.")
    warn("[Strawberry Hub] download failed: " .. tostring(httpErr))
    return
end

local fn, compileErr = loadstring(src)
if not fn then
    notify("Script failed to start (" .. string.sub(tostring(compileErr), 1, 80) .. "). Ask in " .. DISCORD)
    warn("[Strawberry Hub] loadstring failed: " .. tostring(compileErr))
    return
end

local ok, runErr = xpcall(fn, debug.traceback)
if not ok then
    notify("Script error: " .. string.sub(tostring(runErr), 1, 80) .. " - ask in " .. DISCORD)
    warn("[Strawberry Hub] script error: " .. tostring(runErr))
end
