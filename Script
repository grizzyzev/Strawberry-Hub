        if rawPeak > 0.05 and tnow - rawPeakT > 3 then
            calRaw = nil
            learnedRaw = math.max(learnedRaw or 0, rawPeak)
        end
        local full = calRaw or learnedRaw
        if full and raw > full + 0.01 then
            if calRaw then calRaw = raw else learnedRaw = raw end
            full = raw
        end
        if full and full > 0.05 then return math.clamp(raw / full, 0, 1) end
        return raw
    end
